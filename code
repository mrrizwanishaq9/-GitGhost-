# -----------------------------
# Helper functions
# -----------------------------

def mask_secret(value):
    value = str(value)

    if len(value) <= 8:
        return "*" * len(value)

    return value[:4] + "*" * (len(value) - 7) + value[-3:]


def entropy(text):
    if not text:
        return 0.0

    counts = {}
    for char in text:
        counts[char] = counts.get(char, 0) + 1

    length = len(text)

    return -sum(
        (count / length) * math.log2(count / length)
        for count in counts.values()
    )


def confidence(secret, pattern_type):
    score = 60

    if len(secret) >= 20:
        score += 10

    if len(secret) >= 32:
        score += 10

    ent = entropy(secret)

    if ent >= 3.5:
        score += 10

    if pattern_type in {
        "AWS Access Key",
        "GitHub Token",
        "Private Key",
        "Stripe Secret Key"
    }:
        score += 10

    return min(score, 99)


def sha256_text(text):
    return hashlib.sha256(text.encode(errors="ignore")).hexdigest()


def is_probably_text(path):
    try:
        with open(path, "rb") as f:
            chunk = f.read(4096)

        if b"\x00" in chunk:
            return False

        return True

    except Exception:
        return False


def severity_weight(severity):
    return {
        "CRITICAL": 25,
        "HIGH": 15,
        "MEDIUM": 8,
        "LOW": 3
    }.get(severity, 1)


