print("\n[2/7] 🔎 Discovering files...")

files = []

for root, dirs, filenames in os.walk(REPO_DIR):

    dirs[:] = [
        d for d in dirs
        if d not in IGNORE_DIRS
    ]

    for filename in filenames:

        path = Path(root) / filename

        try:
            if path.stat().st_size > MAX_FILE_SIZE:
                continue
        except:
            continue

        if (
            path.suffix.lower() in TEXT_EXTENSIONS
            or filename.lower() in SENSITIVE_FILENAMES
            or filename.startswith(".env")
        ):
            files.append(path)

print(f"✓ Candidate files: {len(files)}")

# -----------------------------
# Pattern scanning
# -----------------------------

print("\n[3/7] 🧠 Running secret detection engine...")

findings = []
seen = set()

for path in files:

    try:
        if not is_probably_text(path):
            continue

        content = path.read_text(
            encoding="utf-8",
            errors="ignore"
        )

    except Exception:
        continue

    relative = str(path.relative_to(REPO_DIR))

    lines = content.splitlines()

    for line_number, line in enumerate(lines, 1):

        # -------------------------
        # Regex rules
        # -------------------------

        for rule_name, severity, pattern in RULES:

            try:
                matches = re.finditer(
                    pattern,
                    line
                )
            except re.error:
                continue

            for match in matches:

                raw = match.group(0)

                # Don't report tiny values
                if len(raw.strip()) < 8:
                    continue

                key = (
                    relative,
                    line_number,
                    rule_name,
                    sha256_text(raw)[:16]
                )

                if key in seen:
                    continue

                seen.add(key)

                conf = confidence(
                    raw,
                    rule_name
                )

                findings.append({
                    "id": f"GG-{len(findings)+1:04d}",
                    "type": rule_name,
                    "severity": severity,
                    "confidence": conf,
                    "file": relative,
                    "line": line_number,
                    "source": "Current File",
                    "detected": mask_secret(raw),
                    "fingerprint": sha256_text(raw)[:16],
                    "recommendation":
                        "Remove the credential and rotate it if it is real."
                })

                if len(findings) >= MAX_FINDINGS:
                    break

            if len(findings) >= MAX_FINDINGS:
                break

        if len(findings) >= MAX_FINDINGS:
            break

        # -------------------------
        # Entropy detection
        # -------------------------

        # Look for long assignment values
        entropy_matches = re.finditer(
            r"(?i)\b(?:key|token|secret|password|credential|value)\b"
            r"\s*[:=]\s*['\"]([A-Za-z0-9_\-+/=.]{20,})['\"]",
            line
        )

        for match in entropy_matches:

            value = match.group(1)

            ent = entropy(value)

            if ent < 4.0:
                continue

            key = (
                relative,
                line_number,
                "High Entropy Secret",
                sha256_text(value)[:16]
            )

            if key in seen:
                continue

            seen.add(key)

            findings.append({
                "id": f"GG-{len(findings)+1:04d}",
                "type": "High Entropy Secret",
                "severity": "MEDIUM",
                "confidence": min(
                    95,
                    int(65 + ent * 6)
                ),
                "file": relative,
                "line": line_number,
                "source": "Entropy Analysis",
                "detected": mask_secret(value),
                "fingerprint": sha256_text(value)[:16],
                "recommendation":
                    "Review this high-entropy value and move real credentials to environment variables."
            })

        if len(findings) >= MAX_FINDINGS:
            break

